<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Banco Seguro</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#contenido-principal">Saltar al contenido</a>
    <header class="site-header">
        <div class="topbar">
            <a class="brand" asp-page="/Index" aria-label="Banco Seguro, inicio">
                <span class="brand-mark" aria-hidden="true"><span>BS</span></span>
                <span class="brand-name">Banco <strong>Seguro</strong><small>Banca digital</small></span>
            </a>
            <div class="header-actions">
                <span class="secure-session"><span class="session-lock" aria-hidden="true">✓</span> Sesión segura</span>
                <span class="header-divider" aria-hidden="true"></span>
                <span class="client-profile">
                    <span class="client-avatar" aria-hidden="true">CA</span>
                    <span class="client-name">Cliente Demo<small>Perfil personal</small></span>
                </span>
            </div>
        </div>
        <nav class="main-nav" aria-label="Navegación principal">
            <a class="@(Context.Request.Path == "/" ? "active" : null)" asp-page="/Index">Inicio</a>
            <a class="@(Context.Request.Path == "/dashboard" ? "active" : null)" asp-page="/Dashboard">Mis cuentas</a>
            <a class="@(Context.Request.Path == "/movements" ? "active" : null)" asp-page="/Movements">Movimientos</a>
        </nav>
    </header>
    <main class="container" id="contenido-principal">
        @RenderBody()
    </main>
    <footer class="site-footer">
        <strong>Banco Seguro S.A.</strong>
        <span>Demostración académica · Datos ficticios</span>
    </footer>
</body>
</html>
