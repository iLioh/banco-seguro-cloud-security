<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Banco Seguro</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <div class="topbar">
            <a class="brand" asp-page="/Index" aria-label="Banco Seguro, inicio">
                <span class="brand-mark" aria-hidden="true">BS</span>
                <span class="brand-name">Banco <strong>Seguro</strong><small>Banca Digital</small></span>
            </a>
            <span class="secure-session"><span aria-hidden="true">●</span> Entorno seguro</span>
        </div>
        <nav class="main-nav" aria-label="Navegación principal">
            <a asp-page="/Index">Inicio</a>
            <a asp-page="/Dashboard">Mis cuentas</a>
            <a asp-page="/Movements">Movimientos</a>
            <a class="technical-link" asp-page="/Security">Seguridad <small>Demo técnica</small></a>
        </nav>
    </header>
    <main class="container" id="contenido-principal">
        @RenderBody()
    </main>
    <footer class="site-footer">
        <div><strong>Banco Seguro S.A.</strong><span> Banca digital de demostración</span></div>
        <span>Conexión protegida · Datos ficticios</span>
    </footer>
</body>
</html>
