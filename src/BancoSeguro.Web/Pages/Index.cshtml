@page
@model IndexModel
@{
    ViewData["Title"] = "Inicio";
}
<section class="hero">
    <div class="hero-content">
        <span class="eyebrow eyebrow-light">Banco Seguro Digital</span>
        <h1>Bienvenido a tu banca digital.</h1>
        <p>Consulta el saldo de tus cuentas y revisa tus últimos movimientos en un solo lugar.</p>
        <a class="button button-light" asp-page="/Dashboard">Ingresar a mi banca <span aria-hidden="true">→</span></a>
        <p class="simulation-note"><span aria-hidden="true">●</span> Demostración con datos ficticios · No requiere credenciales</p>
    </div>
    <div class="hero-visual" aria-hidden="true">
        <div class="digital-card">
            <span class="digital-card-brand"><span class="mini-brand-mark">BS</span> BANCO SEGURO</span>
            <span class="digital-card-chip"></span>
            <span class="digital-card-number">•••• &nbsp;•••• &nbsp;•••• &nbsp;1001</span>
            <span class="digital-card-footer"><span>CLIENTE DEMO</span><span>DÉBITO</span></span>
        </div>
    </div>
</section>

<section class="benefits" aria-label="Características de Banco Seguro Digital">
    <article>
        <span class="benefit-icon" aria-hidden="true">✓</span>
        <div><h2>Acceso protegido</h2><p>Tu información se consulta mediante conexiones seguras.</p></div>
    </article>
    <article>
        <span class="benefit-icon" aria-hidden="true">$</span>
        <div><h2>Resumen de cuentas</h2><p>Saldos y productos organizados en una sola vista.</p></div>
    </article>
    <article>
        <span class="benefit-icon" aria-hidden="true">↕</span>
        <div><h2>Movimientos recientes</h2><p>Consulta la actividad de tus cuentas de forma clara.</p></div>
    </article>
</section>
