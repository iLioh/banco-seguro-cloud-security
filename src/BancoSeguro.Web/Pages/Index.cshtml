@page
@model IndexModel
@{
    ViewData["Title"] = "Inicio";
}
<section class="hero">
    <div class="hero-content">
        <span class="eyebrow eyebrow-light">Banco Seguro Digital</span>
        <h1>Tu banco, más cerca y siempre seguro.</h1>
        <p>Consulta tus cuentas y movimientos desde una experiencia digital simple, protegida y diseñada para ti.</p>
        <a class="button button-light" asp-page="/Dashboard">Ingresar a mi banca <span aria-hidden="true">→</span></a>
        <p class="simulation-note">Acceso de demostración · No requiere credenciales</p>
    </div>
    <div class="hero-visual" aria-hidden="true">
        <div class="digital-card">
            <span class="digital-card-brand">BANCO SEGURO</span>
            <span class="digital-card-chip"></span>
            <span class="digital-card-number">•••• &nbsp;•••• &nbsp;•••• &nbsp;1001</span>
            <span class="digital-card-footer">CLIENTE DEMO</span>
        </div>
    </div>
</section>

<section class="benefits" aria-label="Beneficios de Banco Seguro Digital">
    <article>
        <span class="benefit-icon" aria-hidden="true">24/7</span>
        <div><h2>Siempre disponible</h2><p>Revisa tu información bancaria cuando la necesites.</p></div>
    </article>
    <article>
        <span class="benefit-icon" aria-hidden="true">✓</span>
        <div><h2>Información clara</h2><p>Tus saldos y movimientos en una vista sencilla.</p></div>
    </article>
    <article>
        <span class="benefit-icon" aria-hidden="true">◇</span>
        <div><h2>Seguridad integrada</h2><p>Protección cloud aplicada detrás de cada consulta.</p></div>
    </article>
</section>
