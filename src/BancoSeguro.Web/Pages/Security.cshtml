@page "/security"
@model SecurityModel
@{
    ViewData["Title"] = "Seguridad";
}
<header class="page-head">
    <div>
        <span class="eyebrow">Demostración técnica</span>
        <h1>Seguridad y servicios cloud</h1>
        <p>Estado técnico de los controles que protegen Banco Seguro Digital.</p>
    </div>
    <span class="technical-badge"><span aria-hidden="true">●</span> Vista de laboratorio</span>
</header>
<aside class="technical-notice">Esta sección muestra únicamente estados operativos. No expone secretos, credenciales, cadenas de conexión ni identificadores internos.</aside>
<section class="technical-grid" aria-label="Estado de controles técnicos">
    <partial name="_StatusCard" model='("Managed Identity", Model.IdentityStatus)' />
    <partial name="_StatusCard" model='("Azure Key Vault", Model.KeyVaultStatus)' />
    <partial name="_StatusCard" model='("Azure SQL", Model.DatabaseStatus)' />
    <partial name="_StatusCard" model='("API interna", Model.InternalApiStatus)' />
    <partial name="_StatusCard" model='("Aplicación", Model.ApplicationStatus)' />
    <partial name="_StatusCard" model='("InternalApiToken", Model.TokenStatus)' />
</section>

<section class="security-foundation" aria-labelledby="proteccion-integrada">
    <div><span class="eyebrow">Diseño seguro</span><h2 id="proteccion-integrada">Protección integrada</h2></div>
    <ul class="security-facts">
        <li><strong>Identidad sin contraseñas</strong><span>Microsoft Entra ID y Managed Identity</span></li>
        <li><strong>Conectividad privada</strong><span>VNet Integration y Private Endpoints</span></li>
        <li><strong>Datos cifrados</strong><span>TLS y validación de certificados</span></li>
    </ul>
</section>
