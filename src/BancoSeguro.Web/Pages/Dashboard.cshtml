@page "/dashboard"
@model DashboardModel
@{
    ViewData["Title"] = "Dashboard";
}
<header class="page-head">
    <span class="eyebrow">Estado operativo</span>
    <h1>Dashboard de servicios</h1>
    <p>Vista segura del estado de las integraciones. Nunca muestra credenciales ni secretos.</p>
</header>
<section class="grid">
    <partial name="_StatusCard" model='("Application", Model.ApplicationStatus)' />
    <partial name="_StatusCard" model='("Managed Identity", Model.IdentityStatus)' />
    <partial name="_StatusCard" model='("Key Vault", Model.KeyVaultStatus)' />
    <partial name="_StatusCard" model='("Azure SQL", Model.DatabaseStatus)' />
    <partial name="_StatusCard" model='("Internal API", Model.InternalApiStatus)' />
</section>

